# Base URL of the FastAPI backend (hotelmanagement/).
#
# Pick the one that matches where you are running the app:
#   Android emulator  http://10.0.2.2:8000    (10.0.2.2 is the host from inside the emulator)
#   iOS simulator     http://127.0.0.1:8000
#   Physical device   http://<your-machine-LAN-IP>:8000
#
# Copy this file to .env. Expo only exposes variables prefixed with EXPO_PUBLIC_.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
